<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\..\docs\tessera.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Shipping identity. These populate the Win32 version resource, which is what
       Explorer's Properties dialog and the SmartScreen prompt read. -->
  <PropertyGroup>
    <!-- Calendar build stamp, 1.<year>.<MMdd>.<time>. Every build carries the moment it
         was made, so a user can read the age of their copy straight off Help > About and
         a bug report names one build rather than a range. Captured once, in UTC, and
         every component below is parsed back out of that single string so they cannot
         straddle a second or a midnight boundary mid-build.
         Pass -p:BuildTimestampUtc="yyyy-MM-dd HH:mm:ss" to pin it; a release does exactly
         that, so the published artifact matches the tag it was cut from. -->
    <BuildTimestampUtc Condition="'$(BuildTimestampUtc)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm:ss'))</BuildTimestampUtc>
    <_StampYear>$([System.DateTime]::Parse('$(BuildTimestampUtc)').ToString('yyyy'))</_StampYear>
    <_StampDate>$([System.DateTime]::Parse('$(BuildTimestampUtc)').ToString('MMdd'))</_StampDate>
    <_StampMinute>$([System.DateTime]::Parse('$(BuildTimestampUtc)').ToString('HHmm'))</_StampMinute>

    <!-- HHmm rather than anything finer because every field of the Win32 version
         resource is 16 bits, capped at 65534: an HHmmss component reaches 235959 and
         does not fit. These are also numeric fields, so AssemblyVersion drops the
         leading zero of MMdd (0831 parses as 831); FileVersion keeps it, and it is
         FileVersion that Explorer's Properties dialog shows. -->
    <Version>1.$(_StampYear).$(_StampDate).$(_StampMinute)</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <!-- The same stamp again rather than a finer one: this is the string Help > About
         shows, and one version format everywhere is worth more than seconds of extra
         precision. Being free-form, it is also the only field that keeps the leading
         zero of MMdd, so it reads exactly 1.yyyy.MMdd.HHmm. The SDK appends
         "+<commit sha>", which is what separates two builds made in the same minute. -->
    <InformationalVersion>1.$(_StampYear).$(_StampDate).$(_StampMinute)</InformationalVersion>
    <Product>Tessera</Product>
    <AssemblyTitle>Tessera</AssemblyTitle>
    <Company>Jake Lyon</Company>
    <Authors>Jake Lyon</Authors>
    <Copyright>Copyright © 2026 Jake Lyon. All rights reserved.</Copyright>
    <Description>Disk space analyzer for Windows. Scans a drive or folder and shows where the space went as a squarified treemap alongside a size-sorted tree.</Description>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- The licences of the bundled dependencies require their notices to travel with any
       distributed copy, and a bare single-file exe handed to someone is a distributed
       copy. Embedding is what makes that copy self-sufficient: Help > About reads these
       out of the assembly, never off disk. The loose files stay as well, for the release
       zip and for a framework-dependent build's output folder.
       LogicalName is pinned so the resource keys do not depend on MSBuild's path
       mangling; AboutWindow looks them up by these exact names. -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="Tessera.LICENSE" Visible="false" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="Tessera.THIRD-PARTY-NOTICES.txt" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tessera.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <!-- TreeDataGrid is MIT at every version (see licence.md in its repo); the packages
         just carry no licence metadata, which is why scanners report it as unknown.
         Pinned to 11.1.1 only because that is what this was built and tested against.
         The upstream repo is archived, so nothing newer is coming. -->
    <PackageReference Include="Avalonia.Controls.TreeDataGrid" Version="11.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
  </ItemGroup>
</Project>
