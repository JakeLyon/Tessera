# Codifies the style this codebase already follows, so it is enforced by the editor
# rather than by habit. Severities are deliberately `suggestion` or `silent`, never
# `warning`: the build runs with -warnaserror and a style opinion must not be able to
# fail it.

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_size = 2

[*.{xml,axaml,csproj,props,targets,slnx,run.xml}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.cs]
# ---- Language style ----
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_prefer_braces = when_multiline:silent
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:silent
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion

# ---- Formatting: Allman braces, as used throughout ----
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_preserve_single_line_blocks = true

# ---- Naming ----
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_style.underscore_camel.capitalization  = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_style.s_camel.capitalization  = camel_case
dotnet_naming_style.s_camel.required_prefix = s_

# Private instance fields: _camelCase
dotnet_naming_symbols.private_fields.applicable_kinds           = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields_underscore.symbols            = private_fields
dotnet_naming_rule.private_fields_underscore.style              = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity           = suggestion

# Private static fields: s_camelCase
dotnet_naming_symbols.private_static_fields.applicable_kinds           = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers         = static
dotnet_naming_rule.private_static_fields_prefix.symbols                = private_static_fields
dotnet_naming_rule.private_static_fields_prefix.style                  = s_camel
dotnet_naming_rule.private_static_fields_prefix.severity               = suggestion

# Everything else that is a member: PascalCase
dotnet_naming_symbols.members.applicable_kinds = property,method,event,namespace,class,struct,interface,enum,delegate,type_parameter
dotnet_naming_rule.members_pascal.symbols      = members
dotnet_naming_rule.members_pascal.style        = pascal
dotnet_naming_rule.members_pascal.severity     = suggestion
